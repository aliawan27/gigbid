# Copy to .env and fill. Never commit .env.
GROQ_API_KEYS=gsk_key1,gsk_key2          # comma-separated; rotated automatically on rate limits
LLM_BASE_URL=https://api.groq.com/openai/v1   # http://localhost:11434/v1 for Ollama (MODEL_PROFILE=local)
MODEL_PROFILE=open                       # open | open_qwen | local | paid
DATABASE_URL=                            # postgresql://... (Neon/compose); empty = SQLite
APP_SECRET_KEY=replace_me
REVIEWER_PASSWORD=replace_me
MARKETPLACE_MODE=gigsim                  # gigsim | upwork_live
MARKETPLACE_MCP_TOKEN=replace_me
GIGSIM_API_TOKEN=replace_me
GIGSIM_BASE_URL=http://localhost:8081
PORTFOLIO_MCP_URL=http://localhost:8091/mcp/
MARKETPLACE_MCP_URL=http://localhost:8092/mcp/
WORKSPACE_MCP_URL=http://localhost:8093/mcp/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
UPWORK_CLIENT_ID=
UPWORK_REDIRECT_URI=
GITHUB_TOKEN=                            # read-only PAT for rag/ingest/github_mcp.py
