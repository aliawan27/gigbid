 "search_evidence": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true,
   "title": null
  },
  "input": {
   "$defs": {
    "SearchFilters": {
     "properties": {
      "since": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "ISO date; only evidence on/after this date",
       "title": "Since"
      },
      "types": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "case_study",
           "readme",
           "code",
           "review",
           "cv"
          ],
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Types"
      }
     },
     "title": "SearchFilters",
     "type": "object"
    }
   },
   "properties": {
    "filters": {
     "anyOf": [
      {
       "$ref": "#/$defs/SearchFilters"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "k": {
     "default": 5,
     "maximum": 20,
     "minimum": 1,
     "title": "K",
     "type": "integer"
    },
    "owner": {
     "default": "",
     "title": "Owner",
     "type": "string"
    },
    "requirement": {
     "description": "One job requirement or a whole job post",
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement"
   ],
   "title": "search_evidenceArguments",
   "type": "object"
  }
 },
