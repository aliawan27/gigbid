{
 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": false,
   "title": null
  },
  "input": {
   "$defs": {
    "ProposalIn": {
     "properties": {
      "bid_amount": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "title": "Bid Amount",
       "type": "number"
      },
      "cover_letter": {
       "maxLength": 5000,
       "minLength": 50,
       "title": "Cover Letter",
       "type": "string"
      },
      "dry_run": {
       "default": false,
       "description": "Return exactly what would be sent and what it costs; send nothing",
       "title": "Dry Run",
       "type": "boolean"
      },
      "idempotency_key": {
       "description": "Same key => the action happens once",
       "maxLength": 128,
       "minLength": 8,
       "title": "Idempotency Key",
       "type": "string"
      },
      "job_id": {
       "title": "Job Id",
       "type": "string"
      },
      "screening_answers": {
       "items": {
        "type": "string"
       },
       "maxItems": 10,
       "title": "Screening Answers",
       "type": "array"
      },
      "trace_id": {
       "default": "",
       "title": "Trace Id",
       "type": "string"
      },
      "user_id": {
       "title": "User Id",
       "type": "string"
      }
     },
     "required": [
      "user_id",
      "job_id",
      "cover_letter",
      "bid_amount",
      "idempotency_key"
     ],
     "title": "ProposalIn",
     "type": "object"
    }
   },
   "properties": {
    "p": {
     "$ref": "#/$defs/ProposalIn"
    }
   },
   "required": [
    "p"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  }
 },
